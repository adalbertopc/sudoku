---
import "@/styles/global.css"
import { DEFAULT_LANG, LANGS, LOCALES, ROUTES, getT, type Lang, type PageKey } from "@/i18n/ui"
import { CONTENT, SITE_NAME } from "@/i18n/content"

interface Props {
  lang: Lang
  page: PageKey | "404"
  title?: string
  description?: string
}

const { lang, page } = Astro.props
const t = getT(lang)
const other: Lang = lang === "es" ? "en" : "es"
const content = page === "404" ? null : CONTENT[lang][page]
const title = Astro.props.title ?? content!.title
const description = Astro.props.description ?? content!.description
const site = Astro.site ?? new URL("https://sudoku.adal.dev")
const pageKey: PageKey = page === "404" ? "play" : page
const canonical = new URL(ROUTES[lang][pageKey], site).href
const alternates = LANGS.map((l) => ({ lang: l, href: new URL(ROUTES[l][pageKey], site).href }))
const ogImage = new URL(`/og/${lang}.png`, site).href
const fullTitle = title
const switchHref = ROUTES[other][pageKey]
const links = [
  { href: ROUTES[lang].play, label: t.nav.play, key: "play" },
  { href: ROUTES[lang].print, label: t.nav.print, key: "print" },
]

const AUTHOR = {
  "@type": "Person",
  name: "Adal",
  url: "https://adal.dev",
  sameAs: ["https://x.com/adalcodes", "https://github.com/adalbertopc"],
}
const REPO = "https://github.com/adalbertopc/sudoku"

const websiteId = new URL(`${ROUTES[lang].play}#website`, site).href
const appId = new URL(`${ROUTES[lang].play}#app`, site).href
const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: SITE_NAME[lang],
    url: new URL(ROUTES[lang].play, site).href,
    inLanguage: lang,
    publisher: AUTHOR,
  },
  {
    "@type": "WebApplication",
    "@id": appId,
    name: SITE_NAME[lang],
    url: new URL(ROUTES[lang].play, site).href,
    applicationCategory: "GameApplication",
    applicationSubCategory: lang === "es" ? "Juego de lógica" : "Logic puzzle",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    inLanguage: lang,
    description: CONTENT[lang].play.description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: CONTENT[lang].play.sections.find((s) => s.list)?.list,
    author: AUTHOR,
    sameAs: [REPO],
  },
]
if (content) {
  graph.push({
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: { "@id": websiteId },
    about: { "@id": appId },
    primaryImageOfPage: ogImage,
    ...(page === "print"
      ? {
          breadcrumb: {
            "@type": "BreadcrumbList",
            itemListElement: [
              { "@type": "ListItem", position: 1, name: t.nav.play, item: new URL(ROUTES[lang].play, site).href },
              { "@type": "ListItem", position: 2, name: content.h1, item: canonical },
            ],
          },
        }
      : {}),
  })
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c")
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {page === "404" ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      page !== "404" &&
        alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)
    }
    {page !== "404" && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === DEFAULT_LANG)!.href} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={LOCALES[lang]} />
    <meta property="og:locale:alternate" content={LOCALES[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@adalcodes" />
    <meta name="twitter:creator" content="@adalcodes" />
    <meta name="author" content="Adal" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    {page !== "404" && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      try {
        const stored = localStorage.getItem("sudoku:theme")
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches
        document.documentElement.classList.toggle("dark", dark)
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <header class="sticky top-0 z-40 border-b bg-background/85 backdrop-blur print:hidden">
      <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4 sm:gap-6">
        <a href={ROUTES[lang].play} class="flex items-center gap-2 font-semibold tracking-tight">
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <path d="M8.67 2v20M15.33 2v20M2 8.67h20M2 15.33h20" stroke="currentColor" stroke-width="1.2" opacity="0.5"></path>
          </svg>
          <span class="hidden sm:inline">{SITE_NAME[lang]}</span>
          <span class="sm:hidden">Sudoku</span>
        </a>
        <nav class="flex items-center gap-1 text-sm" aria-label={lang === "es" ? "Principal" : "Main"}>
          {
            links.map((l) => (
              <a
                href={l.href}
                aria-current={page === l.key ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-1.5 transition-colors hover:bg-muted",
                  page === l.key ? "bg-muted font-medium text-foreground" : "text-muted-foreground",
                ]}
              >
                {l.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-1">
          <a
            href={switchHref}
            hreflang={other}
            lang={other}
            aria-label={t.nav.switchLabel}
            class="rounded-md px-2.5 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
          >
            {t.nav.switchTo}
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            aria-label={t.nav.theme}
          >
            <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t print:hidden">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <p>{SITE_NAME[lang]} · {lang === "es" ? "Sin registro y sin anuncios. Todo funciona en tu navegador." : "No sign-up, no ads, runs entirely in your browser."}</p>
        <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label={lang === "es" ? "Pie de página" : "Footer"}>
          <a class="hover:text-foreground" href={ROUTES[lang].play}>{CONTENT[lang].play.h1}</a>
          <a class="hover:text-foreground" href={ROUTES[lang].print}>{CONTENT[lang].print.h1}</a>
          <a class="hover:text-foreground" href={switchHref} hreflang={other} lang={other}>{getT(other).langName}</a>
        </nav>
      </div>
      <div class="mx-auto flex max-w-7xl flex-col gap-2 border-t px-4 py-4 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <p>
          {lang === "es" ? "Hecho por" : "Made by"}{" "}
          <a
            href="https://x.com/adalcodes"
            rel="author noopener"
            target="_blank"
            class="inline-flex items-center gap-1 font-medium text-foreground hover:underline underline-offset-4"
          >
            <svg viewBox="0 0 24 24" class="size-3" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
            @adalcodes
          </a>
        </p>
        <a href={REPO} rel="noopener" target="_blank" class="inline-flex items-center gap-1.5 hover:text-foreground">
          <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
          </svg>
          {lang === "es" ? "Código abierto en GitHub" : "Open source on GitHub"}
        </a>
      </div>
    </footer>
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark")
        try {
          localStorage.setItem("sudoku:theme", dark ? "dark" : "light")
        } catch {}
      })
    </script>
  </body>
</html>
