---
import Layout from "@/layouts/Layout.astro"
import { ROUTES } from "@/i18n/ui"
---

<Layout lang="es" page="404" title="Página no encontrada · Page not found" description="La página que buscas no existe. The page you are looking for does not exist.">
  <div class="mx-auto grid max-w-xl gap-6 px-4 py-24 text-center">
    <p class="font-mono text-6xl font-semibold tracking-tight">404</p>
    <div class="grid gap-1">
      <h1 class="text-xl font-semibold">Página no encontrada</h1>
      <p class="text-muted-foreground" lang="en">Page not found</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3 text-sm">
      <a class="rounded-lg bg-primary px-4 py-2 font-medium text-primary-foreground" href={ROUTES.es.play}>Jugar sudoku</a>
      <a class="rounded-lg border px-4 py-2 font-medium" href={ROUTES.en.play} lang="en">Play sudoku</a>
    </div>
  </div>
</Layout>
